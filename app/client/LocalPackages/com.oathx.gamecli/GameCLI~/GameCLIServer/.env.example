# Copy to .env and generate a random webhook secret before starting.
GAMECLI_HOST=127.0.0.1
GAMECLI_PORT=8088
GAMECLI_PROJECT_KEYS=AI9527
GAMECLI_WEBHOOK_TOKEN=

# Enable per-client heartbeat diagnostics when needed.
GAMECLI_LOG_HEARTBEATS=false

# Track database connection. Copy to .env.database; do not commit credentials.
GAMEAI_STORAGE=postgres
GAMEAI_PROJECT_KEY=DEMO
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gameai
PGUSER=gameai_track
PGPASSWORD=
# Migrations/seed use .env.database-admin with a separate database owner.
# Set GAMEAI_STORAGE=demo explicitly for offline UI tests.
