# Keep artifact directory skeletons, ignore generated contents.
/workspace/assets/*
!/workspace/assets/.gitkeep
/workspace/repo/*
!/workspace/repo/.gitkeep
!/workspace/builds/
/workspace/builds/*
!/workspace/builds/.gitkeep

# Python local environments and caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
