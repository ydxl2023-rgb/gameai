# Service listener. Copy to .env; do not commit credentials.
GAMECLI_HOST=127.0.0.1
GAMECLI_PORT=8088

# Track database connection. Copy to .env.database; do not commit credentials.
GAMEAI_STORAGE=postgres
GAMEAI_PROJECT_KEY=DEMO
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gameai
PGUSER=gameai_track
PGPASSWORD=
# Migrations/seed use .env.database-admin with a separate database owner.
# Set GAMEAI_STORAGE=demo explicitly for offline UI tests.

# Local browser Agent configuration only; separate restricted credentials in .env.agent-manager.
GAMEAI_LOCAL_AGENT_MANAGEMENT=false
# GAMEAI_TRACK_ORIGIN=http://127.0.0.1:8090

# Workflow writer and submission token live in .env.workflow (setup-review.mjs).
# Human initial login lives in .env.review-account; never pass it to an Agent.
